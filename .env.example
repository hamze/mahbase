# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,proxy
DJANGO_LOG_LEVEL=INFO
# Django serves /media/ itself (any DEBUG value); set false only when a proxy serves /media/
DJANGO_SERVE_MEDIA=true

# PostgreSQL
POSTGRES_DB=mahbase
POSTGRES_USER=mahbase
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT (Simple JWT): short-lived access token, rotating + blacklisted refresh token
JWT_ACCESS_MINUTES=5
# Customers: sliding session that ends after this many days without a visit; staff: fixed 1 day
JWT_REFRESH_DAYS=90
JWT_STAFF_REFRESH_DAYS=1

# Media uploads and temporary-media retention
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_MIN_DIMENSION=50
MEDIA_MAX_DIMENSION=6000
MEDIA_WEBP_QUALITY=82
MEDIA_TEMPORARY_RETENTION_HOURS=24

# Customer OTP login: one code per mobile per OTP_RESEND_SECONDS, OTP_RATE_IP code requests per IP
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_IP=30/hour
# SMS panel class: console (writes messages to stdout, development) or
# accounts.services.sms.kavenegar.KavenegarSmsSender (pattern names in backend/accounts/services/sms/templates.py)
SMS_SENDER=accounts.services.sms.console.ConsoleSmsSender
KAVENEGAR_API_KEY=

# Orders and payments. STOREFRONT_URL is the public storefront origin (the bank returns customers to
# STOREFRONT_URL/api/payments/return/). The mock bank (payment-mock/) is reached by the backend at
# PAYMENT_MOCK_API_URL and by the browser at PAYMENT_MOCK_PUBLIC_URL.
ORDER_RESERVATION_MINUTES=15
STOREFRONT_URL=http://localhost:8081
PAYMENT_GATEWAY=commerce.services.payment_gateway.mock_bank.MockBankGateway
PAYMENT_MERCHANT_ID=mahbase-test-merchant
PAYMENT_MOCK_API_URL=http://localhost:8090
PAYMENT_MOCK_PUBLIC_URL=http://localhost:8090

# Celery (reservation expiry every RESERVATION_EXPIRY_INTERVAL_SECONDS)
CELERY_BROKER_URL=redis://localhost:6380/0
# Shared cache for the contact-form rate limits (CONTACT_RATE_IP / _MOBILE_MINUTE / _MOBILE_HOUR, DRF rate syntax).
CACHE_URL=redis://localhost:6380/1
# Comma-separated internal-page slugs linked from the storefront menu (cannot be deleted).
SITE_MENU_INTERNAL_PAGES=
RESERVATION_EXPIRY_INTERVAL_SECONDS=30

# Next.js admin (cookie lifetimes must stay below the JWT lifetimes above)
JWT_ACCESS_COOKIE_SECONDS=240
JWT_REFRESH_COOKIE_SECONDS=86400
COOKIE_SECURE=true

# Host ports for local testing (docker compose)
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
PROXY_HOST_PORT=8080
ADMIN_PANEL_HOST_PORT=3000
STOREFRONT_HOST_PORT=8081
# Next.js servers without nginx in front (debugging only)
ADMIN_PANEL_DIRECT_HOST_PORT=3001
STOREFRONT_DIRECT_HOST_PORT=3002
PAYMENT_MOCK_HOST_PORT=8090
REDIS_HOST_PORT=6380

# Server stack (docker-compose.server.yml, behind Traefik). Add every domain to DJANGO_ALLOWED_HOSTS, set
# STOREFRONT_URL=https://$SITE_DOMAIN and PAYMENT_MOCK_PUBLIC_URL=https://$PAYMENT_MOCK_DOMAIN.
SITE_DOMAIN=example.ir
ADMIN_DOMAIN=admin.example.ir
PAYMENT_MOCK_DOMAIN=pay.example.ir
TRAEFIK_ENTRYPOINT=web
